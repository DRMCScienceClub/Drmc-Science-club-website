# Phase 1 runs without environment values.
# Add real values only in .env.local or encrypted deployment settings.

# Public site configuration
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server configuration — never expose this variable to client code
SUPABASE_SERVICE_ROLE_KEY=

# Initial admin bootstrap — keep disabled after the first administrator is created
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
ALLOW_INITIAL_ADMIN_BOOTSTRAP=

# Future contact and membership delivery
CONTACT_RECIPIENT_EMAIL=
MEMBERSHIP_RECIPIENT_EMAIL=
